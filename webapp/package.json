{
  "name": "pricelens-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:browser": "playwright test",
    "build": "npm run check && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
